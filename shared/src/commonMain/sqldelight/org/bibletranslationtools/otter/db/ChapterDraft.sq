-- Which chunk layout (draft) is active for a chapter. A rechunk adds the new layout's rows under a new
-- draft number and makes it active here, keeping the old layout's rows and takes so the rechunk can be
-- undone. A chapter with no row here has only one layout, and all its rows are current.
CREATE TABLE chapter_draft (
    chapter_fk       INTEGER AS kotlin.Int PRIMARY KEY REFERENCES collection_entity(id) ON DELETE CASCADE,
    active_draft     INTEGER AS kotlin.Int NOT NULL
);

activeDraft:
SELECT active_draft FROM chapter_draft WHERE chapter_fk = :chapterId;

setActiveDraft:
INSERT OR REPLACE INTO chapter_draft (chapter_fk, active_draft) VALUES (:chapterId, :draft);

chaptersWithDrafts:
SELECT chapter_fk FROM chapter_draft;
