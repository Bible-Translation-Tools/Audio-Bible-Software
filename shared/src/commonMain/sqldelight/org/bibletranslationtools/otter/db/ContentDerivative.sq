-- Mirrors sql/CreateAppDb.sql `content_derivative` + its two indexes.
CREATE TABLE content_derivative (
    id               INTEGER AS kotlin.Int PRIMARY KEY AUTOINCREMENT,
    content_fk       INTEGER AS kotlin.Int NOT NULL REFERENCES content_entity(id) ON DELETE CASCADE,
    source_fk        INTEGER AS kotlin.Int NOT NULL REFERENCES content_entity(id) ON DELETE CASCADE
);

CREATE INDEX idx_content_derivative_content ON content_derivative (content_fk);
CREATE INDEX idx_content_derivative_source ON content_derivative (source_fk);
