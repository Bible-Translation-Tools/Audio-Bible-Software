-- Mirrors sql/CreateAppDb.sql `workbook_type`.
CREATE TABLE workbook_type (
    id               INTEGER AS kotlin.Int PRIMARY KEY AUTOINCREMENT,
    name             TEXT NOT NULL,
    UNIQUE (name COLLATE NOCASE) ON CONFLICT IGNORE
);

-- Queries for WorkbookTypeDao (enum cache: DAO lazily seeds missing enum rows on first access). ---

selectAll:
SELECT id, name FROM workbook_type;

insert:
INSERT INTO workbook_type (name) VALUES (?);

selectMaxId:
SELECT max(id) FROM workbook_type;
