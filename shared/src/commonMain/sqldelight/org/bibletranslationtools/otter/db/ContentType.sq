-- Mirrors sql/CreateAppDb.sql `content_type`.
CREATE TABLE content_type (
    id               INTEGER AS kotlin.Int PRIMARY KEY AUTOINCREMENT,
    name             TEXT NOT NULL,
    UNIQUE (name COLLATE NOCASE) ON CONFLICT IGNORE
);

-- Queries for ContentTypeDao (enum cache: DAO lazily seeds missing enum rows on first access). ---

selectAll:
SELECT id, name FROM content_type;

insert:
INSERT INTO content_type (name) VALUES (?);

selectMaxId:
SELECT max(id) FROM content_type;
